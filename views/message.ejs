<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <h1>Message Details</h1>

    <div
      class="message-card"
      style="
        border: 1px solid #334155;
        padding: 1.5rem;
        border-radius: 6px;
        margin-bottom: 2rem;
      "
    >
      <p><strong>Author:</strong> <%= message.user %></p>
      <p><strong>Message:</strong> <%= message.text %></p>
      <p>
        <small style="color: #94a3b8"
          ><strong>Timestamp:</strong> <%= message.added.toLocaleString()
          %></small
        >
      </p>
    </div>

    <p><a href="/">&larr; Back to Home</a></p>

    <%- include('partials/footer') %>
  </body>
</html>
