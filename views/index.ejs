<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1><%= title %></h1>
    
    <a href="/new">Write a new message</a>

    <!-- Inside views/index.ejs -->
<div class="messages-container">
    <% messages.forEach((msg) => { %>
        <div class="message-card" style="border: 1px solid #334155; padding: 1rem; margin: 1rem 0; border-radius: 6px;">
            <p><strong><%= msg.username %></strong> says:</p>
            <p><%= msg.text %></p>
            <small style="color: #94a3b8;"><%= msg.added.toLocaleString() %></small>
            <br><br>
            
            <a href="/messages/<%= msg.id %>" style="color: #38bdf8;">Open Message Detail</a>
            
            <!-- Delete Form -->
            <form action="/messages/<%= msg.id %>/delete" method="POST" style="display:inline; margin-left: 10px;">
                <button type="submit" style="background: #ef4444; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer;">Delete</button>
            </form>
        </div>
    <% }) %>
</div>

    <%- include('partials/footer') %>
</body>
</html>