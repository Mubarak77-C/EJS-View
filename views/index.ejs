<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <!-- Link your static CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navigation Render -->
    <nav>
      <ul>
        <% links.forEach((link) => { %>
          <li><a href="<%= link.href %>"><%= link.text %></a></li>
        <% }) %>
      </ul>
    </nav>

    <h1><%= message %></h1>
    <p>This HTML was dynamically generated on the server using EJS.</p>

    <!-- Include the Reusable Footer -->
    <%- include('partials/footer') %>
</body>
</html>