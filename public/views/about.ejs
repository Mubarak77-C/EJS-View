<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
</head>
<body>
    <!-- Navigation Render -->
    <nav>
      <ul>
        <% links.forEach((link) => { %>
          <li><a href="<%= link.href %>"><%= link.text %></a></li>
        <% }) %>
      </ul>
    </nav>

    <h1><%= title %></h1>
    <p><%= message %></p>

    <!-- Include the EXACT Same Reusable Footer -->
    <%- include('partials/footer') %>
</body>
</html>